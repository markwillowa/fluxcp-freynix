	<br><div id='review' style='margin: auto;'><div class='review-BL-top'><!-- empty --></div><div class='review-BL-mid'><div style='padding: 3px 0 3px 5px; border-bottom: 2px solid #38719C; text-align: left; margin: 0px 5px;'><img src = 'images/circle.gif'><a href = '/index.php?page=detailedlistserver&serid=23603&url_sname=OlamRO' class='sb_m' >
		OlamRO - 150x/150x/50x</a></div><div style='padding: 2px; border-bottom: 2px solid #38719C; margin: 0px 5px;'>
		<table cellpadding=0 cellspacing=0>
			<tr class='switch'>
